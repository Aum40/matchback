# URL ของ API (NestJS) — เว็บเรียกจากฝั่ง server เท่านั้น เบราว์เซอร์ไม่เห็น
API_URL=http://localhost:8000

# คีย์เข้ารหัสคุกกี้ session ของ next-auth สร้าง: pnpm dlx auth secret
# หรือ node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# URL ของเว็บ — ต้องตั้งทุกครั้งที่รันแบบ production รวมถึง `pnpm build && pnpm start` ในเครื่อง
# ไม่ตั้ง = next-auth ปฏิเสธทุก session (UntrustedHost ใน log) ล็อกอินแล้วเด้งกลับหน้า login เงียบ ๆ
# `pnpm dev` ไม่ต้องตั้ง
# AUTH_URL=http://localhost:3000

# --- Google login (ไม่ใส่ทั้งคู่ = ซ่อนปุ่ม Google) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID ต้องเป็นตัวเดียวกับที่ API ใช้
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# รหัสลับร่วมกับ API (ค่าเดียวกับ INTERNAL_API_SECRET ของ API) — production ควรตั้ง ตอน dev ไม่ต้อง
# Optional judge demo accounts (server-side only; never expose passwords to the browser)
DEMO_CANDIDATE_EMAIL=
DEMO_CANDIDATE_PASSWORD=
DEMO_RECRUITER_EMAIL=
DEMO_RECRUITER_PASSWORD=

INTERNAL_API_SECRET=
