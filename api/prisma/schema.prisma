// ชื่อ model/field เป็น PascalCase/camelCase ส่วนชื่อตาราง/คอลัมน์ใน DB เป็น snake_case ผ่าน @@map/@map

generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// USER = ผู้สมัคร (candidate) — คงชื่อเดิมไว้ ไม่งั้นต้อง migrate ข้อมูลและ token ที่ออกไปแล้วทั้งหมด
enum Role {
  USER
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  /// เก็บเป็นตัวพิมพ์เล็กเสมอ (UsersService แปลงให้ก่อนบันทึก/ค้นหา)
  email          String     @unique
  name           String
  /// null = บัญชีที่สมัครผ่าน Google และยังไม่ได้ตั้งรหัสผ่าน
  password       String?
  googleId       String?    @unique @map("google_id")
  role           Role       @default(USER)
  /// SUSPENDED = แอดมินระงับบัญชี AuthGuard ปฏิเสธทุกคำขอทันที (403 ACCOUNT_SUSPENDED)
  status         UserStatus @default(ACTIVE)
  /// เลขรุ่นของ session: access token ทุกใบพกเลขนี้ไว้ (ver)
  /// +1 = token ที่ออกก่อนหน้าใช้ไม่ได้ทันทีแม้ยังไม่หมดอายุ (ระงับบัญชี, เปลี่ยนรหัสผ่าน)
  sessionVersion Int        @default(0) @map("session_version")
  /// soft delete: มีค่า = ลบแล้ว AuthGuard ตอบ 401 และไม่นับว่ามีบัญชีนี้อยู่
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens   RefreshToken[]
  profile         CandidateProfile?
  skills          CandidateSkill[]
  jobInteractions JobInteraction[]
  applications    Application[]
  /// เฉพาะ recruiter: บริษัทที่สังกัด (หนึ่งคนหนึ่งบริษัท) ผู้สมัครเป็น null เสมอ
  /// สิทธิ์จัดการงานเช็กจากค่านี้ในฐานข้อมูลทุกครั้ง ไม่เชื่อจาก token
  companyId       String?                @map("company_id") @db.Uuid
  company         Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recruiterSwipes CandidateInteraction[] @relation("RecruiterSwipes")
  receivedSwipes  CandidateInteraction[] @relation("CandidateSwiped")
  matches         Match[]

  @@index([companyId])
  @@map("users")
}

/// refresh token: ใช้ขอ access token ใบใหม่โดยไม่ต้องล็อกอินซ้ำ
/// - เก็บเฉพาะ sha256 ของ token ไม่เก็บตัวจริง
/// - ใช้แล้วได้ใบใหม่ทุกครั้ง (rotation) ใบใหม่อยู่ family เดียวกับใบเดิม
/// - ใบที่ใช้ไปแล้วถูกเอามาใช้ซ้ำ = token หลุด → ยกเลิกทั้ง family
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// token ทุกใบที่หมุนต่อกันมาจากการล็อกอินครั้งเดียว (หนึ่งอุปกรณ์/เบราว์เซอร์)
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// เวลาที่ถูกใช้ขอใบใหม่ (ละเอียดระดับมิลลิวินาที ใช้เทียบช่วงผ่อนผันตอนหน้าเว็บส่งคำขอพร้อมกัน)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// MATCHBACK domain
// ---------------------------------------------------------------------------

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum SwipeDirection {
  LIKE
  SKIP
}

/// สถานะที่ผู้สมัครอัปเดตเอง — ระบบไม่ได้รับข้อมูลจากนายจ้างอัตโนมัติ
/// DRAFT = recruiter ยังไม่เปิด, PUBLISHED = ผู้สมัครเห็นและปัดได้, CLOSED = ปิดรับแล้ว (ซ่อนจากผู้สมัคร)
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  INTERESTED
  APPLIED
  INTERVIEWING
  REJECTED
  OFFER
}

/// ทักษะกลางที่ทั้งงานและผู้สมัครอ้างถึง
/// id เป็น slug คงที่ (เช่น "typescript") ไม่ใช่ uuid: seed รันซ้ำได้และโค้ด/เทสต์อ้างถึงได้ตรง ๆ
model Skill {
  id       String @id
  name     String @unique
  category String

  jobs       JobSkill[]
  candidates CandidateSkill[]

  @@map("skills")
}

model Job {
  id              String          @id
  title           String
  company         String
  location        String
  workArrangement WorkArrangement @map("work_arrangement")
  employmentType  EmploymentType  @map("employment_type")
  /// เงินเดือนต่อเดือน (บาท) null = ประกาศไม่ระบุ
  salaryMin       Int?            @map("salary_min")
  salaryMax       Int?            @map("salary_max")
  description     String
  /// true = ข้อมูลตัวอย่างสำหรับเดโม ไม่ใช่ประกาศงานจริง UI ต้องติดป้ายบอกเสมอ
  isDemo          Boolean         @default(true) @map("is_demo")
  /// งานที่ recruiter สร้างเริ่มเป็น DRAFT ผู้สมัครเห็นเฉพาะ PUBLISHED
  /// (งาน seed เดิมถูก backfill เป็น PUBLISHED ใน migration two_sided_matching)
  status          JobStatus       @default(DRAFT)
  /// เจ้าของงาน null = แถวเก่าที่ไม่มีเจ้าของ (seed ผูกงานเดโมทุกงานกับบริษัทเดโมแล้ว)
  /// ชื่อ relation เป็น owner เพราะ `company` เป็นคอลัมน์ชื่อบริษัทสำหรับแสดงผลอยู่แล้ว
  companyId       String?         @map("company_id") @db.Uuid
  owner           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  skills                JobSkill[]
  interactions          JobInteraction[]
  applications          Application[]
  candidateInteractions CandidateInteraction[]
  matches               Match[]

  @@index([status])
  @@index([companyId])
  @@map("jobs")
}

model JobSkill {
  jobId    String  @map("job_id")
  skillId  String  @map("skill_id")
  /// false = nice-to-have มีน้ำหนักในคะแนนน้อยกว่า required (ดู matching/match-score.ts)
  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

/// โปรไฟล์ผู้สมัคร 1:1 กับ User — ไม่มีแถว = ยังไม่ได้กรอก (คะแนนจะถือว่า "ข้อมูลไม่พอ" ไม่ใช่ "ไม่ผ่าน")
model CandidateProfile {
  userId                   String           @id @map("user_id") @db.Uuid
  headline                 String?
  education                String?
  /// ข้อความอิสระ ใช้ตรวจว่าทักษะที่ไม่ได้ติ๊กไว้ถูกพูดถึงในประสบการณ์/โปรเจกต์หรือไม่
  experience               String?
  projects                 String?
  desiredRoles             String[]         @map("desired_roles")
  preferredSalaryMin       Int?             @map("preferred_salary_min")
  preferredWorkArrangement WorkArrangement? @map("preferred_work_arrangement")
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model CandidateSkill {
  userId  String @map("user_id") @db.Uuid
  skillId String @map("skill_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("candidate_skills")
}

/// การปัดของผู้ใช้ต่องานหนึ่ง (ปัดซ้ำ = เขียนทับ) ใช้กรองงานที่เห็นแล้วออกจากหน้า Discover
model JobInteraction {
  userId    String         @map("user_id") @db.Uuid
  jobId     String         @map("job_id")
  direction SwipeDirection
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("job_interactions")
}

/// ปัดขวา = สร้างแถว INTERESTED ผู้ใช้เลื่อนสถานะเองหลังสมัครจริง
model Application {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  jobId            String            @map("job_id")
  status           ApplicationStatus @default(INTERESTED)
  notes            String?
  /// feedback จริงจากนายจ้างที่ผู้ใช้จดเอง
  employerFeedback String?           @map("employer_feedback")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status])
  @@map("applications")
}

/// บริษัทของ recruiter — หนึ่ง recruiter มีได้บริษัทเดียว (ไม่มีระบบทีม/หลายบริษัทใน MVP)
model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  website     String?
  /// true = บริษัทสมมติจาก seed ต้องติดป้าย Demo data เหมือนงานเดโม
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recruiters User[]
  jobs       Job[]

  @@map("companies")
}

/// การตัดสินใจของฝั่งบริษัทต่อผู้สมัครหนึ่งคนสำหรับงานหนึ่งงาน (ปัดซ้ำ = เขียนทับ)
/// หนึ่งคำตัดสินต่อคู่ (งาน, ผู้สมัคร) ไม่ว่า recruiter คนไหนของบริษัทเป็นคนปัด
/// recruiterId เก็บไว้แค่ว่าใครปัด ไม่ได้ใช้ตัดสินสิทธิ์
model CandidateInteraction {
  jobId       String         @map("job_id")
  candidateId String         @map("candidate_id") @db.Uuid
  recruiterId String         @map("recruiter_id") @db.Uuid
  direction   SwipeDirection
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate User @relation("CandidateSwiped", fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter User @relation("RecruiterSwipes", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@id([jobId, candidateId])
  @@index([candidateId])
  @@index([recruiterId])
  @@map("candidate_interactions")
}

/// mutual match: สร้างเฉพาะใน swipe service ตอนที่ทั้งสองฝั่ง LIKE แล้วเท่านั้น
/// ไม่มี endpoint ให้ client สร้าง/ลบเอง และ SKIP ทีหลังไม่ลบ match ที่เกิดแล้ว
/// unique (candidateId, jobId) คือสิ่งที่กันการกดพร้อมกันไม่ให้เกิด match ซ้ำ
model Match {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id")
  candidateId String   @map("candidate_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@map("matches")
}
